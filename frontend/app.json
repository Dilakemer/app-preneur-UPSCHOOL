{
  "expo": {
    "name": "caremind",
    "slug": "caremind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dilakemer.caremind",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "CareMind, arac muayene, sigorta, kasko ve bakim tarihleri yaklastiginda hatirlatici gonderir.",
        "NSLocationWhenInUseUsageDescription": "Yakindaki TUVTURK istasyonlarini bulmak icin konumunuz kullanilir."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.dilakemer.caremind",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "scheme": "caremind",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#6366F1",
          "defaultChannel": "caremind-hatirlatici"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakindaki TUVTURK istasyonlarini bulmak icin konumunuz kullanilir."
        }
      ]
    ]
  }
}
